<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_due_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="13dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Próximo vencimento"
            android:textAllCaps="true"
            android:textColor="@color/widget_text_muted"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_due_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Atualizado --:--"
            android:textColor="@color/widget_text_muted"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_due_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Sem vencimentos pendentes"
        android:textColor="@color/widget_danger"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_due_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_metric_background"
        android:ellipsize="end"
        android:maxLines="1"
        android:padding="7dp"
        android:text="Saldo: R$ 0,00"
        android:textColor="@color/widget_primary"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
