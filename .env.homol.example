# Preencher com a URL homol e o Supabase escolhido para este ambiente.
# Credenciais vazias impedem o build de homologação; não há fallback para produção.
NUXT_PUBLIC_APP_ENV=homol
HOMOL_WEB_URL=
HOMOL_SUPABASE_PROJECT_REF=
# Compartilhamento temporário com produção exige autorização explícita.
HOMOL_ALLOW_SHARED_PRODUCTION_DB=false
SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_KEY=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
# Vazio = API na mesma origem da WebView.
NUXT_PUBLIC_API_BASE_URL=
NUXT_PUBLIC_UPDATE_MANIFEST_URL=
# Usado pelo Gradle no APK homol; origem HTTPS sem path/query.
ANDROID_HOMOL_URL=
