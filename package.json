{
  "name": "planilha",
  "version": "2.0.0",
  "private": true,
  "description": "Plataforma Planilha - Migrado para Spring Boot 3 + Java 21 e React 19 + HeroUI + Dark Neon",
  "scripts": {
    "dev": "npm --prefix frontend-react run dev",
    "dev:front": "npm --prefix frontend-react run dev",
    "build:front": "npm --prefix frontend-react run build",
    "test:front": "npm --prefix frontend-react run test",
    "test:e2e": "npm --prefix frontend-react run test:e2e",
    "test:back": "powershell -NoProfile -Command \"Set-Location backend-java; .\\mvnw.cmd test -B -ntp\"",
    "verify:back": "powershell -NoProfile -Command \"Set-Location backend-java; .\\mvnw.cmd verify -B -ntp\"",
    "seed:local": "node scripts/java-react/seed-teste.mjs",
    "ci": "powershell -ExecutionPolicy Bypass -File scripts/java-react/ci-local.ps1",
    "cap": "powershell -NoProfile -Command \"Set-Location frontend-react; npx cap\"",
    "cap:sync": "powershell -NoProfile -Command \"Set-Location frontend-react; npx cap sync\"",
    "cap:open:android": "powershell -NoProfile -Command \"Set-Location frontend-react; npx cap open android\"",
    "build:mobile": "powershell -NoProfile -Command \"npm run build:front; Set-Location frontend-react; npx cap sync\""
  },
  "keywords": [
    "financas",
    "planejamento-financeiro",
    "spring-boot",
    "java-21",
    "react-19",
    "heroui",
    "tailwind-css",
    "postgresql"
  ]
}
